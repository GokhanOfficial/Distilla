# Server
PORT=3000
APP_NAME=Distilla
# APP_URL=https://distilla.example.com
CORS_ORIGIN=*
RUST_LOG=distilla=info,tower_http=info

# Upload Limits (MB)
MAX_UPLOAD_SIZE_MB=1024

# AI Provider (OpenAI-Compatible API)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
# Comma-separated model IDs (display labels are auto-generated from IDs, e.g. gemini-2.5-flash -> Gemini 2.5 Flash)
AI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gpt-4o,gpt-4o-mini
AI_DEFAULT_MODEL=gemini-2.5-flash
AI_FILENAME_MODEL=gpt-4o-mini
# PDF sending mode for OpenAI-compatible APIs: "image_url" (broad proxy compatibility) or "file" (native OpenAI file input)
PDF_INPUT_MODE=image_url

# Media Processing (FFmpeg / FFprobe)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MEDIA_MAX_OUTPUT_SIZE_MB=100
MEDIA_TARGET_OUTPUT_SIZE_MB=95
MEDIA_MIN_AUDIO_BITRATE_KBPS=32
MEDIA_MAX_AUDIO_BITRATE_KBPS=320
MEDIA_OUTPUT_SAMPLE_RATE=44100

# Office -> PDF Conversion
# Primary: local headless LibreOffice (included in Docker image)
LIBREOFFICE_PATH=soffice
# Optional fallback if LibreOffice is unavailable: Google Drive OAuth
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_TOKEN=

# Markdown -> PDF Engine
# Leave blank to auto-detect chromium / google-chrome-stable from PATH
# CHROMIUM_PATH=/usr/bin/chromium
PDF_MAX_CONCURRENCY=2
